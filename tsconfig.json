{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "paths": { "@tui2web/runtime": ["./runtime/index.ts"] },
    "noEmit": true
  },
  "include": ["runtime/**/*.ts", "web/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
